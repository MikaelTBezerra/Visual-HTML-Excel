<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>895f9c18-c1dc-4b75-8554-6e9585268a0e</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>GT Energia</ProviderName>
  <DefaultLocale>pt-BR</DefaultLocale>
  <DisplayName DefaultValue="Visual HTML GTF"/>
  <Description DefaultValue="Renderiza um visual HTML/JS dentro da planilha, alimentado por tabelas do Excel."/>
  <IconUrl DefaultValue="https://mikaeltbezerra.github.io/Visual-HTML-Excel/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://mikaeltbezerra.github.io/Visual-HTML-Excel/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://mikaeltbezerra.github.io/Visual-HTML-Excel/index.html"/>
  <Hosts>
    <Host Name="Workbook"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.8"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://mikaeltbezerra.github.io/Visual-HTML-Excel/index.html"/>
    <RequestedWidth>640</RequestedWidth>
    <RequestedHeight>400</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <AllowSnapshot>true</AllowSnapshot>
</OfficeApp>
